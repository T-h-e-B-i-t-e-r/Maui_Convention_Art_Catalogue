<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage"
             xmlns:local="clr-namespace:MauiApp1"
             xmlns:models="clr-namespace:MauiApp1.Models"
             x:DataType="local:MainPage">

    <Grid ColumnDefinitions="300, *" RowDefinitions="200, *" ColumnSpacing="20" RowSpacing="20" Padding="20">
        <Border Grid.Column="0"
                Grid.RowSpan="2"
                VerticalOptions="Fill"
                HorizontalOptions="Fill"
                Stroke="#778E9E"
                StrokeThickness="4"
                StrokeShape="RoundRectangle 20"
                Background="#637584">
            <CollectionView BindingContext="{Binding CategoryButtonsViewModel}"
                            ItemsSource="{Binding CategoryButtons}" SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CategoryButton">
                        <Grid Padding="10" RowDefinitions="*" ColumnDefinitions="*">
                            <Border HeightRequest="64"
                                    HorizontalOptions="Fill"
                                    Stroke="#426682"
                                    StrokeThickness="4"
                                    StrokeShape="RoundRectangle 40"
                                    Background="#94AFC6">
                                <Label Text="{Binding Title}" HorizontalOptions="Fill" TextColor="#FFE300"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="30" FontAttributes="Bold"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <Border Grid.Column="1"
                Grid.Row="0"
                VerticalOptions="Fill"
                HorizontalOptions="Fill"
                Stroke="#778E9E"
                StrokeThickness="4"
                StrokeShape="RoundRectangle 20"
                Background="#637584">
        </Border>
        <Border Grid.Column="1"
                Grid.Row="1"
                VerticalOptions="Fill"
                HorizontalOptions="Fill"
                Stroke="#778E9E"
                StrokeThickness="4"
                StrokeShape="RoundRectangle 20"
                Background="#637584">
        </Border>
    </Grid>

</ContentPage>