<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiApp1.Views.ArtItemDisplayPopup"
             xmlns:viewmodels="clr-namespace:MauiApp1.ViewModels"
             x:DataType="viewmodels:ArtItemDisplayPopupViewModel"
             HeightRequest="{Binding Height}"
             WidthRequest="{Binding Width}"
             Margin="20">
    <ContentView.Resources>
        <ResourceDictionary>
            <toolkit:BoolToObjectConverter x:Key="IsArtItemFavoritedIcon"
                                           TrueObject="heart_full.png"
                                           FalseObject="heart_empty.png" />
            <toolkit:BoolToObjectConverter x:Key="IsArtItemFavoritedText"
                                           TrueObject="Saved"
                                           FalseObject="Unsaved" />
        </ResourceDictionary>
    </ContentView.Resources>
    <AbsoluteLayout>
        <Border AbsoluteLayout.LayoutBounds="0.5,0, 400, 70"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Stroke="#778E9E"
                StrokeThickness="4"
                StrokeShape="RoundRectangle 10"
                Background="#637584">
            <Label Text="{Binding ArtItemEntryViewModel.ArtItemEntry.Name}" HorizontalOptions="Fill" TextColor="#FFE300"
                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="30"
                   FontAttributes="Bold" />
        </Border>
        <Image AbsoluteLayout.LayoutBounds="0.64,0,60,60"
               AbsoluteLayout.LayoutFlags="PositionProportional"
               Source="checkbox_grey_cross.png">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseButtonClicked}" Buttons="Primary" />
            </Image.GestureRecognizers>
        </Image>
        <Image AbsoluteLayout.LayoutBounds="0.5,.45,.75,.75"
               AbsoluteLayout.LayoutFlags="All"
               Source="{Binding ArtItemEntryViewModel.ArtItemEntry.SpriteFilename}">
        </Image>
        <StackLayout AbsoluteLayout.LayoutBounds="0.925,0.8,250,350"
                     AbsoluteLayout.LayoutFlags="PositionProportional"
                     Spacing="20">
            <Border Padding="30,0,20,0"
                    Stroke="#778E9E"
                    StrokeThickness="4"
                    StrokeShape="RoundRectangle 40"
                    Background="#637584">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding FavoriteButtonClicked}"
                        Buttons="Primary"
                        CommandParameter="{Binding ArtItemEntryViewModel}" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="*" ColumnDefinitions="2*,*">
                    <Label Grid.Column="0"
                           Text="{Binding ArtItemEntryViewModel.IsFavorite, Converter={StaticResource IsArtItemFavoritedText}}"
                           TextColor="#FFE300"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           FontSize="30"
                           FontAttributes="Bold" />
                    <Image Grid.Column="1"
                           Source="{Binding ArtItemEntryViewModel.IsFavorite, Converter={StaticResource IsArtItemFavoritedIcon}}"
                           HorizontalOptions="End"
                           WidthRequest="50"
                           HeightRequest="50" />
                </Grid>
            </Border>
            <Border Stroke="#778E9E"
                    StrokeThickness="4"
                    StrokeShape="RoundRectangle 20"
                    Background="#637584">
                <StackLayout Padding="20">
                    <Label Text="Date:" HorizontalOptions="Start" TextColor="#FFE300" FontSize="20" />
                    <Label Text="{Binding ArtItemEntryViewModel.ArtItemEntry.Date}" HorizontalOptions="Start" TextColor="#FFE300" FontSize="25" />
                    <Label Text="Size:" HorizontalOptions="Start" TextColor="#FFE300" FontSize="20" />
                    <Label Text="{Binding ArtItemEntryViewModel.ArtItemEntry.Size}" HorizontalOptions="Start" TextColor="#FFE300" FontSize="25" />
                    <Label Text="Price:" HorizontalOptions="Start" TextColor="#FFE300" FontSize="20" />
                    <Label Text="{Binding ArtItemEntryViewModel.ArtItemEntry.Price, StringFormat='{0:C2}'}" HorizontalOptions="Start" TextColor="#FFE300"
                           FontSize="25" />
                </StackLayout>
            </Border>
        </StackLayout>
    </AbsoluteLayout>
</ContentView>